# Copiá este archivo como ".env" y completá lo que necesites. Todo es opcional.

PORT=3000
WHATSAPP_NUMERO=543492215273

# Dirección pública del sitio (con https en producción). Google y Mercado Pago la usan
# para volver a la tienda. Si no la ponés, se usa http://localhost:PORT
BASE_URL=

# Firma las sesiones. Poné un texto largo y aleatorio; si lo cambiás, todos deben volver a loguearse.
SESSION_SECRET=

# Login con Google: crear credenciales "ID de cliente de OAuth" (aplicación web) en Google Cloud Console.
# URI de redirección autorizado: <BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mercado Pago: Access Token de la aplicación (panel de desarrolladores).
# Con token se cobra el monto exacto y el webhook confirma los pagos (necesita BASE_URL pública).
# Sin token se usa MP_LINK_FIJO y los pagos no se confirman solos.
MP_ACCESS_TOKEN=
MP_LINK_FIJO=https://link.mercadopago.com.ar/fierrerostore7482992
